{
  "schema": "apgi-equations/2",
  "note": "Each equation links to the Lean theorems that establish its mathematics and the Python functions/tests that check its numerical realisation. `preconditions` are machine-readable; check_consistency.py verifies that registry ranges satisfy them. An optional `scale` multiplies the right-hand side (e.g. dt ≤ τ_S/10).",
  "equations": [
    {"id": "EQ-IGN-1", "name": "Deterministic ignition (hard-threshold form)", "latex": "I(S,\\theta) \\iff S > \\theta",
     "source": "SRC-MATHSPEC", "locator": "Math Spec §5.2 (hard threshold)", "units": {"S": "AU", "theta": "AU"},
     "lean": ["Apgi.Ignites", "Apgi.ignites_antitone_threshold"],
     "python": ["apgi_ref.ignites"], "tests": ["test_twins.py::test_ignites_antitone_threshold"],
     "preconditions": []},
    {"id": "EQ-PREC-1", "name": "Precision-weighted signal (single-channel reduction)", "latex": "S = \\Pi\\,|\\varepsilon|",
     "source": "SRC-MATHSPEC", "locator": "Math Spec Eq. 20, one channel, no excess-magnitude offset", "units": {"Pi": "dimensionless", "epsilon": "AU", "S": "AU"},
     "lean": ["Apgi.ignites_monotone_precision"],
     "python": ["apgi_ref.signal"], "tests": ["test_twins.py::test_ignites_monotone_precision"],
     "preconditions": []},
    {"id": "EQ-IGN-2", "name": "Probabilistic ignition propensity", "latex": "B = 1/(1+e^{-\\gamma_{sig}(S-\\theta)})",
     "source": "SRC-MATHSPEC", "locator": "Math Spec §5.1; γ_sig = 1/τ_σ", "units": {"k": "1/AU", "S": "AU", "theta": "AU", "P": "dimensionless"},
     "lean": ["Apgi.ignitionProb", "Apgi.ignitionProb_antitone_threshold"],
     "python": ["apgi_ref.ignition_prob"], "tests": ["test_twins.py::test_ignition_prob_antitone_threshold", "test_golden_vectors.py"],
     "preconditions": [{"param": "gamma_sig", "op": ">=", "value": "0", "theorem": "Apgi.ignitionProb_antitone_threshold"}]},
    {"id": "EQ-THR-1", "name": "Clamped threshold update", "latex": "\\theta' = \\max(\\theta_{floor}, \\theta + g(\\theta^* - \\theta))",
     "source": "SRC-MATHSPEC", "locator": "Math Spec §4.5 (floor applied after decay)", "units": {"theta": "AU", "g": "dimensionless"},
     "lean": ["Apgi.clampedUpdate", "Apgi.clampedUpdate_floor", "Apgi.operatingRange_not_invariant", "Apgi.operatingRange_invariant_of_target"],
     "python": ["apgi_ref.clamped_update"], "tests": ["test_twins.py::test_clamped_update_floor", "test_twins.py::test_operating_range_counterexample", "test_twins.py::test_operating_range_invariant_of_target"],
     "preconditions": []},
    {"id": "EQ-DECAY-1", "name": "Exact exponential threshold decay", "latex": "\\theta_{t+1} = \\theta_0 + (\\theta_t - \\theta_0)\\,e^{-\\Delta t/\\tau_\\theta}",
     "source": "SRC-MATHSPEC", "locator": "Math Spec Eq. 32", "units": {"theta": "AU", "dt": "s", "tau": "s"},
     "lean": ["Apgi.decayStep", "Apgi.decayGain_mem_Icc", "Apgi.decay_step_mem_Icc"],
     "python": ["apgi_ref.decay_step"], "tests": ["test_twins.py::test_decay_step_bounded", "test_twins.py::test_decay_needs_no_step_bound"],
     "preconditions": []},
    {"id": "EQ-CUSP-1", "name": "Cusp potential (canonical +θ·x sign)", "latex": "V(x) = x^4/4 + a x^2/2 + \\theta x",
     "source": "SRC-MATHSPEC-V12D", "locator": "Math Spec v1.2 draft §7.7, Eq. 7.7a–b", "units": {"x": "dimensionless", "a": "dimensionless", "theta": "dimensionless"},
     "lean": ["Apgi.cuspV", "Apgi.cuspV_hasDerivAt", "Apgi.cusp_unique_equilibrium", "Apgi.cusp_two_equilibria_witness", "Apgi.cusp_three_equilibria", "Apgi.cusp_three_equilibria_converse", "Apgi.cusp_three_equilibria_iff"],
     "python": ["apgi_ref.cusp_V", "apgi_ref.cusp_dV", "apgi_ref.cusp_equilibria"],
     "tests": ["test_twins.py::test_cusp_derivative", "test_twins.py::test_cusp_unique_equilibrium", "test_twins.py::test_cusp_discriminant", "test_twins.py::test_cusp_three_equilibria", "test_twins.py::test_cusp_three_equilibria_converse", "test_golden_vectors.py"],
     "preconditions": [],
     "claims": {"hysteresis": "a < 0 is NECESSARY (Lean: cusp_unique_equilibrium). Three distinct equilibria hold IF AND ONLY IF 4a^3 + 27θ^2 < 0 (Lean: cusp_three_equilibria_iff; the discriminant condition already forces a < 0). None of this is evidence that APGI exhibits hysteresis in data."}},
    {"id": "EQ-UPD-1", "name": "Convex bounded update", "latex": "x' = x + g(u - x)",
     "source": "SRC-MATHSPEC", "units": {"g": "dimensionless"},
     "lean": ["Apgi.convex_update_mem_Icc"],
     "python": ["apgi_ref.convex_update"], "tests": ["test_twins.py::test_convex_update_bounded"],
     "preconditions": []},
    {"id": "EQ-EULER-1", "name": "Forward-Euler relaxation step", "latex": "x' = x + (\\Delta t/\\tau)(u - x)",
     "source": "SRC-MATHSPEC", "locator": "Math Spec §7.5; step rule p43", "units": {"dt": "s", "tau": "s"},
     "lean": ["Apgi.euler_step_mem_Icc"],
     "python": ["apgi_ref.euler_step"], "tests": ["test_twins.py::test_euler_step_bounded"],
     "preconditions": [
       {"param": "dt", "op": "<=", "param_rhs": "tau_theta", "theorem": "Apgi.euler_step_mem_Icc"},
       {"param": "dt", "op": "<=", "param_rhs": "tau_S", "theorem": "Apgi.euler_step_mem_Icc"},
       {"param": "dt", "op": "<=", "param_rhs": "tau_S", "scale": "1/10", "theorem": "accuracy rule, Math Spec p43 (dt ≤ min(τ)/10)"},
       {"param": "dt", "op": "<=", "param_rhs": "tau_theta", "scale": "1/10", "theorem": "accuracy rule, Math Spec p43 (dt ≤ min(τ)/10)"},
       {"param": "dt", "op": "<=", "param_rhs": "tau_Pi", "scale": "1/10", "theorem": "accuracy rule, Notation Appendix p16 (dt ≤ min(τ_S, τ_θ, τ_Π)/10)"},
       {"param": "dt_reservoir", "op": "<=", "param_rhs": "tau_S", "scale": "1/10", "theorem": "accuracy rule with the reservoir active, Math Spec p26"},
       {"param": "dt_reservoir", "op": "<=", "param_rhs": "tau_theta", "scale": "1/10", "theorem": "accuracy rule with the reservoir active, Math Spec p26"},
       {"param": "dt_reservoir", "op": "<=", "param_rhs": "tau_Pi", "scale": "1/10", "theorem": "accuracy rule with the reservoir active, Math Spec p26"},
       {"param": "dt_reservoir", "op": "<=", "param_rhs": "tau_res", "scale": "1/10", "theorem": "accuracy rule with the reservoir active, Math Spec p26 (τ_res down to 10 ms gives dt ≤ 1 ms)"}]},
    {"id": "EQ-LAND-1", "name": "Landauer bound", "latex": "E_L = k_B T \\ln 2",
     "source": "SRC-MATHSPEC", "locator": "Math Spec §11.1", "units": {"k_B": "J/K", "T": "K", "E_L": "J/bit"},
     "lean": [], "python": ["apgi_ref.landauer"], "tests": ["test_golden_vectors.py", "test_conflicts.py::test_landauer_registry_value"],
     "preconditions": []},
    {"id": "EQ-LEAK-1", "name": "Leaky integrator with exact gain", "latex": "S_{t+1} = (1-\\lambda) S_t + \\lambda S^{inst}_t,\\quad \\lambda = 1 - e^{-\\Delta t/\\tau_S}",
     "source": "SRC-MATHSPEC", "locator": "Math Spec Eq. 23–24 (p18)", "units": {"S": "AU", "dt": "s", "tau_S": "s", "lambda": "dimensionless"},
     "lean": ["Apgi.leakGain", "Apgi.leakStep", "Apgi.leakGain_mem_Ioo", "Apgi.leak_step_mem_Icc", "Apgi.leak_two_steps"],
     "python": ["apgi_ref.leak_gain", "apgi_ref.leak_step"], "tests": ["test_twins.py::test_leak_gain_in_open_unit_interval", "test_twins.py::test_leak_step_bounded", "test_twins.py::test_leak_two_steps"],
     "preconditions": [
       {"param": "tau_S", "op": ">", "value": "0", "theorem": "Apgi.leakGain_mem_Ioo"}]},
    {"id": "EQ-HAZARD-1", "name": "dt-invariant ignition hazard", "latex": "P(B_t = 1) = 1 - e^{-r_{max} B_t \\Delta t}",
     "source": "SRC-MATHSPEC", "locator": "Math Spec Eq. 35 (p22); Notation Appendix §2 (p3)", "units": {"r_max": "1/s", "B": "dimensionless", "dt": "s", "P": "dimensionless"},
     "lean": ["Apgi.hazardProb", "Apgi.hazardProb_mem_Icc", "Apgi.hazard_survival_add", "Apgi.hazard_two_steps", "Apgi.hazard_n_steps", "Apgi.hazardProb_monotone_propensity", "Apgi.hazard_antitone_threshold"],
     "python": ["apgi_ref.hazard_prob"], "tests": ["test_twins.py::test_hazard_prob_in_unit_interval", "test_twins.py::test_hazard_two_steps", "test_twins.py::test_hazard_n_steps", "test_twins.py::test_hazard_monotone_propensity", "test_twins.py::test_hazard_antitone_threshold", "test_twins.py::test_per_step_bernoulli_is_not_dt_invariant"],
     "preconditions": [
       {"param": "r_max", "op": ">=", "value": "0", "theorem": "Apgi.hazardProb_mem_Icc"},
       {"param": "gamma_sig", "op": ">=", "value": "0", "theorem": "Apgi.hazard_antitone_threshold"}]},
    {"id": "EQ-NE-1", "name": "NE sub-dominance clamp", "latex": "g' = g \\text{ if } |\\gamma_{NE}| g \\le 0.5 \\text{ else } 0.5/|\\gamma_{NE}|;\\ 1 + \\gamma_{NE} g' \\in [0.5, 1.5]",
     "source": "SRC-MATHSPEC", "locator": "Math Spec §4.4 (p14), Step 4 (p43); Notation Appendix §5 (p9)", "units": {"gamma_NE": "dimensionless", "g_NE": "dimensionless"},
     "lean": ["Apgi.neClamp", "Apgi.neClamp_nonneg", "Apgi.neClamp_bound", "Apgi.neClamp_of_le", "Apgi.neFactor_mem_Icc", "Apgi.neFactor_band", "Apgi.neThreshold_pos"],
     "python": ["apgi_ref.ne_clamp", "apgi_ref.ne_factor"], "tests": ["test_twins.py::test_ne_clamp_bound", "test_twins.py::test_ne_factor_band", "test_twins.py::test_ne_clamp_identity_within_bound"],
     "preconditions": []},
    {"id": "EQ-ALLO-1", "name": "Canonical allostatic threshold update, then exact decay and floor", "latex": "\\theta_{t+1} = \\max(\\theta_{floor},\\ \\theta_0 + (\\theta_t + \\eta_\\theta [C_t - V_t] + \\delta_{reset} B_t - \\theta_0) e^{-\\Delta t/\\tau_\\theta})",
     "source": "SRC-MATHSPEC", "locator": "Math Spec Eq. 26 (p19), applied before the decay of Eq. 32 and the §4.5 floor; Notation Appendix §7 (p11)", "units": {"theta": "AU", "eta_theta": "dimensionless", "C": "AU", "V": "AU", "delta_reset": "AU", "B": "dimensionless"},
     "lean": ["Apgi.allostaticStep", "Apgi.thresholdStep", "Apgi.decayStep_monotone", "Apgi.thresholdStep_floor", "Apgi.thresholdStep_monotone_ignition", "Apgi.thresholdStep_monotone_drive"],
     "python": ["apgi_ref.allostatic_step", "apgi_ref.threshold_step"], "tests": ["test_twins.py::test_threshold_step_floor", "test_twins.py::test_threshold_step_monotone_ignition", "test_twins.py::test_threshold_step_monotone_drive"],
     "preconditions": [
       {"param": "delta_reset", "op": ">=", "value": "0", "theorem": "Apgi.thresholdStep_monotone_ignition"},
       {"param": "eta_theta", "op": ">=", "value": "0", "theorem": "Apgi.thresholdStep_monotone_drive"}]},
    {"id": "EQ-PSI-1", "name": "Signed valence transform Ψ(z)", "latex": "\\Psi(z) = \\alpha^+ \\tanh(\\gamma^+ z)\\ (z \\ge 0);\\ \\alpha^- \\tanh(\\gamma^- z)\\ (z < 0)",
     "source": "SRC-MATHSPEC", "locator": "Math Spec Eq. 21 (p17); Notation Appendix §3 (p6)", "units": {"z": "dimensionless", "Psi": "dimensionless"},
     "lean": ["Apgi.psi", "Apgi.psi_abs_lt", "Apgi.psi_symmetric", "Apgi.psi_odd_of_symmetric"],
     "python": ["apgi_ref.psi"], "tests": ["test_twins.py::test_psi_bounded", "test_twins.py::test_psi_symmetric_limit", "test_twins.py::test_psi_odd_when_symmetric"],
     "preconditions": [
       {"param": "alpha_plus", "op": ">", "value": "0", "theorem": "Apgi.psi_abs_lt"},
       {"param": "alpha_minus", "op": ">", "value": "0", "theorem": "Apgi.psi_abs_lt"}]},
    {"id": "EQ-PREC-SM-1", "name": "Somatic-marker precision modulation", "latex": "\\Pi^i_{eff} = \\mathrm{clamp}_{[\\Pi_{min}, \\Pi_{max}]}(g_{NE}\\,\\Pi^i_{baseline}\\,e^{\\beta_{SM} \\hat M(c,a)})",
     "source": "SRC-NOTATION", "locator": "Notation Appendix §3 (p6) and §5 (p9); Math Spec p9", "units": {"Pi": "AU", "g_NE": "dimensionless", "beta_SM": "dimensionless", "M_hat": "dimensionless"},
     "lean": ["Apgi.precEff", "Apgi.precClamp", "Apgi.precEff_nonneg", "Apgi.precEff_monotone_marker", "Apgi.precClamp_mem_Icc"],
     "python": ["apgi_ref.prec_eff", "apgi_ref.prec_clamp"], "tests": ["test_twins.py::test_prec_eff_monotone_marker", "test_twins.py::test_prec_clamp_bounds"],
     "preconditions": [
       {"param": "beta_SM", "op": ">=", "value": "0", "theorem": "Apgi.precEff_monotone_marker"}]}
  ]
