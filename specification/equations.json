{
  "schema": "apgi-equations/1",
  "note": "Each equation links to the Lean theorems that establish its mathematics and the Python functions/tests that check its numerical realisation. `preconditions` are machine-readable; check_consistency.py verifies that registry ranges satisfy them (plan edit C4).",
  "equations": [
    {"id": "EQ-IGN-1", "name": "Deterministic ignition", "latex": "I(S,\\theta) \\iff S > \\theta",
     "source": "SRC-INNOV-GDOC", "units": {"S": "AU", "theta": "AU"},
     "lean": ["Apgi.Ignites", "Apgi.ignites_antitone_threshold"],
     "python": ["apgi_ref.ignites"], "tests": ["test_twins.py::test_ignites_antitone_threshold"],
     "preconditions": []},
    {"id": "EQ-PREC-1", "name": "Precision-weighted signal", "latex": "S = \\Pi\\,|\\varepsilon|",
     "source": "SRC-INNOV-GDOC", "units": {"Pi": "dimensionless", "epsilon": "AU", "S": "AU"},
     "lean": ["Apgi.ignites_monotone_precision"],
     "python": ["apgi_ref.signal"], "tests": ["test_twins.py::test_ignites_monotone_precision"],
     "preconditions": []},
    {"id": "EQ-IGN-2", "name": "Probabilistic ignition", "latex": "P = 1/(1+e^{-k(S-\\theta)})",
     "source": "SRC-NOTATION", "units": {"k": "1/AU", "S": "AU", "theta": "AU", "P": "dimensionless"},
     "lean": ["Apgi.ignitionProb", "Apgi.ignitionProb_antitone_threshold"],
     "python": ["apgi_ref.ignition_prob"], "tests": ["test_twins.py::test_ignition_prob_antitone_threshold", "test_golden_vectors.py"],
     "preconditions": [{"param": "k_sigmoid", "op": ">=", "value": "0", "theorem": "Apgi.ignitionProb_antitone_threshold"}]},
    {"id": "EQ-THR-1", "name": "Clamped threshold update", "latex": "\\theta' = \\max(\\theta_{floor}, \\theta + g(\\theta^* - \\theta))",
     "source": "SRC-DYN", "units": {"theta": "AU", "g": "dimensionless"},
     "lean": ["Apgi.clampedUpdate", "Apgi.clampedUpdate_floor", "Apgi.operatingRange_not_invariant", "Apgi.operatingRange_invariant_of_target"],
     "python": ["apgi_ref.clamped_update"], "tests": ["test_twins.py::test_clamped_update_floor", "test_twins.py::test_operating_range_counterexample", "test_twins.py::test_operating_range_invariant_of_target"],
     "preconditions": []},
    {"id": "EQ-CUSP-1", "name": "Cusp potential (canonical +θ·x sign)", "latex": "V(x) = x^4/4 + a x^2/2 + \\theta x",
     "source": "SRC-INNOV-GDOC", "units": {"x": "dimensionless", "a": "dimensionless", "theta": "dimensionless"},
     "lean": ["Apgi.cuspV", "Apgi.cuspV_hasDerivAt", "Apgi.cusp_unique_equilibrium", "Apgi.cusp_two_equilibria_witness"],
     "python": ["apgi_ref.cusp_V", "apgi_ref.cusp_dV", "apgi_ref.cusp_equilibria"],
     "tests": ["test_twins.py::test_cusp_derivative", "test_twins.py::test_cusp_unique_equilibrium", "test_twins.py::test_cusp_discriminant", "test_golden_vectors.py"],
     "preconditions": [],
     "claims": {"hysteresis": "a < 0 is NECESSARY (Lean). Three equilibria iff 4a^3 + 27θ^2 < 0 (classical discriminant; tested numerically, not proved in Lean)."}},
    {"id": "EQ-UPD-1", "name": "Convex bounded update", "latex": "x' = x + g(u - x)",
     "source": "SRC-DYN", "units": {"g": "dimensionless"},
     "lean": ["Apgi.convex_update_mem_Icc"],
     "python": ["apgi_ref.convex_update"], "tests": ["test_twins.py::test_convex_update_bounded"],
     "preconditions": []},
    {"id": "EQ-EULER-1", "name": "Forward-Euler relaxation step", "latex": "x' = x + (\\Delta t/\\tau)(u - x)",
     "source": "SRC-DYN", "units": {"dt": "s", "tau": "s"},
     "lean": ["Apgi.euler_step_mem_Icc"],
     "python": ["apgi_ref.euler_step"], "tests": ["test_twins.py::test_euler_step_bounded"],
     "preconditions": [{"param": "dt", "op": "<=", "param_rhs": "tau_theta", "theorem": "Apgi.euler_step_mem_Icc"}]},
    {"id": "EQ-LAND-1", "name": "Landauer bound", "latex": "E_L = k_B T \\ln 2",
     "source": "SRC-THERMO", "units": {"k_B": "J/K", "T": "K", "E_L": "J/bit"},
     "lean": [], "python": ["apgi_ref.landauer"], "tests": ["test_golden_vectors.py", "test_conflicts.py::test_landauer_registry_value"],
     "preconditions": []}
  ]
}
