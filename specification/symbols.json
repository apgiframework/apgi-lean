    {"id": "A", "symbol": "A(t)", "meaning": "Arousal only", "unit": "dimensionless"},
    {"id": "theta_tilde", "symbol": "θ̃", "meaning": "Dimensionless rescaled cusp threshold (θ_eff − S)/u₀", "unit": "dimensionless"},
