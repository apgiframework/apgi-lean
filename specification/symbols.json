    {"id": "theta_eff", "symbol": "θ_eff,t", "meaning": "Comparison threshold (read-out only, never written back)", "unit": "AU"},
    {"id": "B_prop", "symbol": "Bₜ", "meaning": "Ignition propensity σ(γ_sig[Sₜ − θ_eff,t]); never a per-step probability", "unit": "dimensionless"},
    {"id": "B_event", "symbol": "B(t)", "meaning": "Sampled broadcast event {0, 1}", "unit": "dimensionless"},
    {"id": "r_ref", "symbol": "r(t)", "meaning": "Fast refractory term (always carries its argument)", "unit": "AU"},
    {"id": "u_urg", "symbol": "u(t)", "meaning": "Urgency read-out", "unit": "AU"},
    {"id": "C", "symbol": "C(t)", "meaning": "Metabolic-cost deviation", "unit": "AU"},
    {"id": "V", "symbol": "V(t)", "meaning": "Expected information value", "unit": "AU"},
